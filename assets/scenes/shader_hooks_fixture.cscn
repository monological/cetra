{
 "version": 1,
 "_comment": [
  "The shader-hook instrument (spec 13.29): a piece at every place an app's own GLSL",
  "can run, each built so a gate can read from the frame that it ran where it says.",
  "",
  "Regenerate with: python3 assets/generators/gen_shader_hooks_fixture.py"
 ],
 "models": [
  {
   "path": "../models/shader_hooks_fixture.gltf"
  }
 ],
 "environment": {
  "ambient": [
   0.12,
   0.12,
   0.14
  ]
 },
 "lights": [
  {
   "name": "sun",
   "type": "directional",
   "direction": [
    -0.238667,
    -0.795557,
    -0.55689
   ],
   "color": [
    1.0,
    0.97,
    0.92
   ],
   "intensity": 3.0,
   "cast_shadows": true
  }
 ],
 "post": {
  "exposure": 1.0,
  "passes": [
   {
    "at": "beforeDof",
    "shader": "../shaders/hooks_post_mark.glsl",
    "params": {
     "markRect": [
      0.55,
      0.8,
      0.62,
      0.88
     ],
     "markColor": [
      6.0,
      6.0,
      6.0,
      0.0
     ]
    }
   },
   {
    "at": "beforeBloom",
    "shader": "../shaders/hooks_post_mark.glsl",
    "params": {
     "markRect": [
      0.68,
      0.8,
      0.75,
      0.88
     ],
     "markColor": [
      6.0,
      6.0,
      6.0,
      0.0
     ]
    }
   },
   {
    "at": "afterTonemap",
    "shader": "../shaders/hooks_post_mark.glsl",
    "params": {
     "markRect": [
      0.81,
      0.8,
      0.88,
      0.88
     ],
     "markColor": [
      0.25098,
      0.501961,
      0.752941,
      0.0
     ]
    }
   }
  ]
 },
 "shaderHooks": {
  "stripes": {
   "surface": "../shaders/hooks_surface_stripes.glsl"
  },
  "red": {
   "surface": "../shaders/hooks_surface_red.glsl"
  },
  "blue": {
   "surface": "../shaders/hooks_surface_blue.glsl"
  },
  "tint": {
   "surface": "../shaders/hooks_surface_tint.glsl"
  },
  "holes": {
   "surface": "../shaders/hooks_surface_holes.glsl"
  },
  "dome": {
   "surface": "../shaders/hooks_surface_dome.glsl",
   "offset": "../shaders/hooks_offset_dome.glsl",
   "offsetBound": 0.6
  },
  "pushed": {
   "offset": "../shaders/hooks_offset_push.glsl",
   "offsetBound": 0.5
  }
 },
 "materials": {
  "hooks_static": {
   "lateShader": "../shaders/hooks_late_static.glsl",
   "shaderParams": {
    "noiseCells": [
     96.0,
     64.0,
     2.0,
     0.0
    ]
   }
  },
  "hooks_stripes": {
   "shaderHook": "stripes",
   "shaderParams": {
    "stripes": [
     0.3,
     0.03,
     0.8,
     0.0
    ]
   }
  },
  "hooks_key_a": {
   "shaderHook": "red"
  },
  "hooks_key_b": {
   "shaderHook": "blue"
  },
  "hooks_param_a": {
   "shaderHook": "tint",
   "shaderParams": {
    "tint": [
     0.8,
     0.02,
     0.02,
     0.0
    ]
   }
  },
  "hooks_param_b": {
   "shaderHook": "tint",
   "shaderParams": {
    "tint": [
     0.02,
     0.6,
     0.02,
     0.0
    ]
   }
  },
  "hooks_card": {
   "shaderHook": "holes",
   "foliageShadows": 1,
   "shaderParams": {
    "holes": [
     3.0,
     2.0,
     0.3,
     0.0
    ]
   }
  },
  "hooks_dome": {
   "shaderHook": "dome",
   "shaderParams": {
    "dome": [
     0.6,
     1.6,
     0.0,
     0.0
    ]
   }
  },
  "hooks_pushed": {
   "shaderHook": "pushed",
   "shaderParams": {
    "push": [
     0.5,
     0.0,
     0.0,
     0.0
    ]
   }
  }
 },
 "camera": {
  "eye": [
   0.0,
   2.6,
   8.5
  ],
  "target": [
   0.0,
   1.0,
   0.0
  ],
  "fov": 45.0
 }
}
