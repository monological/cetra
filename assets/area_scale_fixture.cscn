{
  "version": 1,
  "_comment": [
    "Scale-invariance gate for the AREA light path (spec 10.2 phase 3).",
    "Run against area_scale_fixture_1000x.cscn: lights x1000 and exposure /1000",
    "must render identically, because scaling every emitter and closing the",
    "camera by the same factor is a no-op on a correctly-normalised pipeline.",
    "",
    "Geometry is sss_fixture.gltf because it is the only fixture with NO glTF",
    "lights and NO emissive material -- the scale test's precondition is that",
    "every emitter in the scene scales together, and cornell_box carries an",
    "emissive panel that does not. Its own SSS materials are left unconfigured",
    "here (no materials block), so this exercises the area path alone."
  ],
  "models": [
    { "path": "sss_fixture.gltf" }
  ],
  "lights": [
    {
      "name": "ScalePanel",
      "type": "area",
      "position": [0.0, 0.9, 0.35],
      "direction": [0.0, -0.8, -0.6],
      "size": [0.6, 0.6],
      "color": [1.0, 0.95, 0.88],
      "intensity": 40.0
    }
  ],
  "camera": {
    "eye": [0.0, 0.25, 1.5],
    "target": [0.0, 0.0, 0.0],
    "fov": 40
  },
  "post": {
    "tonemap": "neutral",
    "exposure": 1.0
  }
}
